/*
 * Sofle ZMK - migrated from sofle-layout.vil (Vial/QMK)
 * Source layers: 0 (base), 2 (symbols/F-keys), 3 (mouse/navigation).
 * Layer 1 deliberately kept as a transparent placeholder to preserve
 * the original Vial layer numbers and MO(2)/MO(3) semantics.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define UNUSED 1
#define SYMBOLS 2
#define NAV_MOUSE 3

/ {
    behaviors {
        // Left: macOS Spaces on base, vertical scrolling on layer 2.
        desktop_encoder: desktop_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(RIGHT)>, <&kp LC(LEFT)>;
        };
        vertical_scroll_encoder: vertical_scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
        // Right: volume on base, horizontal scrolling on layer 3.
        horizontal_scroll_encoder: horizontal_scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            // 6 left keys, 6 right keys; rows 0-2.
            // Row 3 has two encoder pushes, and the thumbs have five keys per side.
            bindings = <
                &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4   &kp N5                       &kp N6    &kp N7     &kp N8     &kp N9    &kp N0   &kp EQUAL
                &kp ESC    &kp Q     &kp W     &kp E     &kp R    &kp T                        &kp Y     &kp U      &kp I      &kp O     &kp P    &kp BSPC
                &kp TAB    &kp A     &kp S     &kp D     &kp F    &kp G                        &kp H     &kp J      &kp K      &kp L     &kp SEMI &kp SQT
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V    &kp B  &kp C_MUTE  &kp C_PP  &kp N  &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                           &kp LCTRL &kp LALT &kp LGUI &mo SYMBOLS &kp RET     &kp SPACE &mo NAV_MOUSE &kp RGUI &kp RALT &kp RCTRL
            >;
            sensor-bindings = <&desktop_encoder &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        unused_layer {
            display-name = "Unused";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&desktop_encoder &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbols_layer {
            display-name = "Symbols (Vial 2)";
            bindings = <
                &trans &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                    &kp F6    &kp F7     &kp F8      &kp F9      &kp F10   &kp F11
                &trans &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                    &kp N6    &kp N7     &kp N8      &kp N9      &kp N0    &kp F12
                &trans &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)           &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LS(BSLH)
                &trans &kp EQUAL &kp MINUS &kp LS(EQUAL) &kp LS(LBKT) &kp LS(RBKT) &trans &trans &kp LBKT &kp RBKT &kp SEMI &kp LS(SEMI) &kp BSLH &trans
                       &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&vertical_scroll_encoder &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        nav_mouse_layer {
            display-name = "Mouse/Nav (Vial 3)";
            bindings = <
                &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
                &trans &mkp LCLK &mmv MOVE_UP &mkp RCLK &none &none   &kp PG_UP &none &kp UP &none &none &trans
                &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &kp CAPS     &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &none &trans
                &trans &kp Z &kp X &kp C &kp V &kp B &trans &trans   &kp DEL &none &none &none &rgb_ug RGB_TOG &trans
                       &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&desktop_encoder &horizontal_scroll_encoder>;
        };
    };
};
